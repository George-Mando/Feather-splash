<!DOCTYPE html>
<html>
<head>
<style>
*{margin:0;padding:0;box-sizing:border-box;}
body{background:#111;display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;font-family:'Courier New',monospace;}
#gameWrap{position:relative;width:480px;max-width:100vw;}
canvas{display:block;width:100%;image-rendering:pixelated;border:3px solid #ff6b35;border-radius:4px;}
#ui{display:flex;justify-content:space-between;align-items:center;padding:6px 10px;background:#1a1a2e;border:1px solid #333;border-top:none;border-radius:0 0 4px 4px;}
#ui span{color:#fff;font-size:12px;font-weight:bold;}
#score{color:#ffd700!important;}
#lives{color:#ff6b35!important;}
#level{color:#7ee8a2!important;}
#controls{margin-top:8px;display:flex;flex-wrap:wrap;gap:6px;justify-content:center;width:100%;}
.ctrl-row{display:flex;gap:6px;justify-content:center;}
button{background:#1a1a2e;border:2px solid #ff6b35;color:#fff;padding:10px 16px;border-radius:6px;cursor:pointer;font-size:13px;font-family:'Courier New',monospace;font-weight:bold;min-width:48px;min-height:44px;user-select:none;-webkit-user-select:none;touch-action:manipulation;}
button:active{background:#ff6b35;color:#111;}
#startBtn{background:#ff6b35;color:#111;padding:10px 24px;font-size:14px;border-color:#ff6b35;}
#msg{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);text-align:center;color:#fff;pointer-events:none;}
#msg h2{font-size:22px;color:#ffd700;text-shadow:2px 2px #000;}
#msg p{font-size:13px;color:#adf;margin-top:6px;}
</style>
</head>
<body>
<div id="gameWrap">
  <canvas id="c" width="480" height="270"></canvas>
  <div id="ui">
    <span>🐟 FEATHER SPLASH</span>
    <span id="score">SCORE: 0</span>
    <span id="lives">❤️ x3</span>
    <span id="level">WORLD 1</span>
  </div>
  <div id="msg">
    <h2>FEATHER SPLASH</h2>
    <p>Classic bird &amp; fish adventure!</p>
  </div>
  <div id="controls">
    <div class="ctrl-row">
      <button id="btnUp">▲ Jump</button>
    </div>
    <div class="ctrl-row">
      <button id="btnLeft">◄</button>
      <button id="btnDown">▼ Duck</button>
      <button id="btnRight">►</button>
    </div>
    <div class="ctrl-row">
      <button id="startBtn" onclick="startGame()">▶ START</button>
    </div>
  </div>
</div>

<script>
// ============================================================
//  FEATHER SPLASH — A classic Mario-style platformer
//  Characters: orange bird player, pufferfish + pelican enemies
//  Features: bricks, question blocks, coins, pipes, flag
// ============================================================

const canvas = document.getElementById('c');
const ctx    = canvas.getContext('2d');
const W = 480, H = 270;

// ── COLOUR CONSTANTS ──────────────────────────────────────
const SKY       = '#6ab4f5';
const WATER     = '#1a6fa8';
const GROUND    = '#5a3e1b';
const GRASS     = '#4caf50';
const PIPE      = '#2d8a2d';
const PIPEDARK  = '#1a5c1a';
const COIN      = '#ffd700';
const BRICK     = '#c0654a';
const BRICKDARK = '#8b3a2a';
const BLOCK     = '#e8b84b';
const BLOCKDARK = '#b8862b';

// ── GAME STATE ────────────────────────────────────────────
let gameState = 'menu';   // 'menu' | 'playing' | 'dead' | 'win'
let score     = 0;
let lives     = 3;
let worldNum  = 1;
let keys      = {};
let frame     = 0;
let cameraX   = 0;

// ── PLAYER OBJECT ─────────────────────────────────────────
let player = {
  x: 80, y: 0, w: 22, h: 26,
  vx: 0, vy: 0,
  onGround:   false,
  dir:        1,          // 1 = right, -1 = left
  invincible: 0,          // frames of invincibility after being hurt
  dead:       false,
  deathVy:    0
};

// ── LEVEL ARRAYS (rebuilt each level) ─────────────────────
let platforms = [];   // ground + raised platforms
let bricks    = [];   // breakable bricks
let qBlocks   = [];   // question blocks (give coins)
let coins     = [];   // floating coins
let pipes     = [];   // green pipes
let enemies   = [];   // pufferfish & pelicans
let particles = [];   // visual particle effects

let flagX        = 0;
let flagY        = 0;
let flagReached  = false;
let flagProgress = 0;

const TILE = 16;                  // one tile = 16 pixels
const GY   = H - 32;             // ground top Y

// ── BUILD LEVEL ───────────────────────────────────────────
function buildLevel(num) {
  platforms=[]; bricks=[]; qBlocks=[]; coins=[];
  pipes=[]; enemies=[]; particles=[];
  flagReached=false; flagProgress=0; cameraX=0;

  const LEN = 180 * TILE;        // total level width in pixels
  flagX = LEN - 3 * TILE;
  flagY = GY  - 7 * TILE;

  // Ground spans the full level
  platforms.push({ x:0, y:GY, w:LEN, h:32, type:'ground' });

  // ── BRICKS & QUESTION BLOCKS ──
  // Each entry: [startTileX, tileY, 'B'|'Q', count]
  const layout = [
    [10,10,'Q',1],
    [14,10,'B',3],[16,10,'Q',1],[18,10,'B',2],
    [22,10,'Q',1],
    [30, 8,'B',4],
    [30, 6,'Q',1],
    [35,10,'Q',1],[36,10,'B',2],[38,10,'Q',1],
    [45, 8,'B',5],
    [50,10,'Q',1],[52,10,'B',2],
    [60, 6,'B',3],[60, 8,'Q',1],
    [70,10,'Q',1],[71,10,'Q',1],[72,10,'Q',1],
    [80, 8,'B',4],
    [85,10,'Q',1],
    [90, 8,'B',3],[92, 8,'Q',1],
    [100,10,'Q',1],[102,10,'B',3],
    [110, 6,'Q',1],[112, 6,'B',2],
    [120,10,'Q',1],[122,10,'Q',1],
    [130, 8,'B',5],
    [140,10,'Q',1],
    [145, 8,'B',3],[147, 8,'Q',1],
    [155,10,'Q',1],[157,10,'B',2],
  ];
  layout.forEach(([tx,ty,type,count]) => {
    for (let i = 0; i < count; i++) {
      const obj = {
        x:    tx*TILE + i*TILE,
        y:    H - ty*TILE,
        w:    TILE, h: TILE,
        hit:  false,
        coin: type==='Q' && i===0
      };
      if (type === 'B') bricks.push(obj);
      else              qBlocks.push(obj);
    }
  });

  // Elevated platforms (islands in the air)
  [[55,12,4],[90,13,3],[128,11,5],[160,12,3]].forEach(([tx,ty,len]) => {
    platforms.push({ x:tx*TILE, y:H-ty*TILE, w:len*TILE, h:TILE, type:'platform' });
  });

  // End staircase (8 steps rising to the right)
  for (let i = 0; i < 8; i++) {
    platforms.push({ x:(165+i)*TILE, y:GY-i*TILE, w:TILE, h:(i+1)*TILE, type:'stair' });
  }

  // ── PIPES ──
  [[18,3],[38,4],[65,3],[95,5],[135,3],[158,3]].forEach(([tx,height]) => {
    pipes.push({ x:tx*TILE, y:GY-height*TILE, w:3*TILE, h:height*TILE });
  });

  // ── SCATTERED COINS ──
  for (let tx = 5; tx < 170; tx += 3) {
    if (Math.random() < 0.35) {
      const ty = 9 + Math.floor(Math.random() * 4);
      coins.push({ x:tx*TILE+4, y:H-ty*TILE, w:8, h:12, collected:false });
    }
  }

  // ── ENEMIES ──
  // Pufferfish walk on the ground; pelicans patrol the air
  [
    {type:'puffer', x:15*TILE},
    {type:'puffer', x:25*TILE},
    {type:'puffer', x:42*TILE},
    {type:'puffer', x:50*TILE},
    {type:'puffer', x:68*TILE},
    {type:'puffer', x:75*TILE},
    {type:'puffer', x:88*TILE},
    {type:'puffer', x:105*TILE},
    {type:'puffer', x:115*TILE},
    {type:'puffer', x:125*TILE},
    {type:'puffer', x:142*TILE},
    {type:'puffer', x:152*TILE},
    {type:'pelican', x:20*TILE,  y:H-14*TILE, range:4*TILE},
    {type:'pelican', x:45*TILE,  y:H-13*TILE, range:3*TILE},
    {type:'pelican', x:72*TILE,  y:H-12*TILE, range:5*TILE},
    {type:'pelican', x:100*TILE, y:H-14*TILE, range:4*TILE},
    {type:'pelican', x:130*TILE, y:H-12*TILE, range:4*TILE},
  ].forEach(e => {
    if (e.type === 'puffer') {
      enemies.push({
        type:'puffer', x:e.x, y:GY-18, w:18, h:18,
        vx:-0.8, dead:false, deathTimer:0, dir:-1, animF:0
      });
    } else {
      enemies.push({
        type:'pelican', x:e.x, y:e.y, w:22, h:20,
        startX:e.x, range:e.range,
        vx:1, dead:false, deathTimer:0, dir:1, animF:0
      });
    }
  });
}

// ── DRAWING HELPERS ───────────────────────────────────────

function drawRect(x, y, w, h, col) {
  ctx.fillStyle = col;
  ctx.fillRect(x - cameraX, y, w, h);
}

// Rounded rectangle helper (used for player/enemy bodies)
function roundRect(c, x, y, w, h, r) {
  c.beginPath();
  c.moveTo(x+r, y);
  c.lineTo(x+w-r, y); c.quadraticCurveTo(x+w, y,   x+w, y+r);
  c.lineTo(x+w, y+h-r); c.quadraticCurveTo(x+w, y+h, x+w-r, y+h);
  c.lineTo(x+r, y+h); c.quadraticCurveTo(x,   y+h, x,   y+h-r);
  c.lineTo(x, y+r);   c.quadraticCurveTo(x,   y,   x+r, y);
  c.closePath();
  c.fill();
}

// ── DRAW BACKGROUND (sky + clouds + water strip) ──────────
function drawBG() {
  ctx.fillStyle = SKY;
  ctx.fillRect(0, 0, W, H);

  // Parallax clouds (scroll at 30% of camera speed)
  const cloudPositions = [
    [60,30],[180,20],[320,35],[420,25],[550,30],[700,20],
    [900,35],[1050,28],[1200,22],[1400,30],[1600,28],[1800,32]
  ];
  cloudPositions.forEach(([cx, cy]) => {
    const sx = cx - cameraX * 0.3;
    if (sx < -80 || sx > W+80) return;
    drawCloud(sx, cy);
  });

  // Water strip at very bottom
  ctx.fillStyle = WATER;
  ctx.fillRect(0, H-16, W, 16);
}

function drawCloud(x, y) {
  ctx.fillStyle = 'rgba(255,255,255,0.85)';
  ctx.beginPath(); ctx.arc(x,    y,   14, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(x+18, y+4, 12, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(x-14, y+4, 10, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.arc(x+4,  y-8, 10, 0, Math.PI*2); ctx.fill();
}

// ── DRAW GROUND & PLATFORMS ───────────────────────────────
function drawGround() {
  platforms.forEach(p => {
    if (p.x - cameraX > W+32 || p.x+p.w - cameraX < -32) return;
    const col = p.type === 'ground' ? GROUND : '#7a4a1e';
    drawRect(p.x, p.y, p.w, p.h, col);
    // Grass strip on top
    drawRect(p.x, p.y, p.w, 4, p.type==='ground' ? GRASS : '#5a8a3a');
    // Subtle texture dots
    ctx.fillStyle = 'rgba(0,0,0,0.1)';
    for (let dx = 8; dx < p.w; dx += 12) {
      ctx.fillRect(p.x + dx - cameraX, p.y + 6, 3, 3);
    }
  });
}

// ── DRAW BRICKS & QUESTION BLOCKS ────────────────────────
function drawBlocks() {
  // Bricks
  bricks.forEach(b => {
    if (b.x - cameraX > W+16 || b.x+b.w - cameraX < -16) return;
    if (b.hit) {
      ctx.fillStyle = BRICKDARK;
      ctx.fillRect(b.x - cameraX, b.y, b.w, b.h);
    } else {
      ctx.fillStyle = BRICK;
      ctx.fillRect(b.x - cameraX, b.y, b.w, b.h);
      // Darker border edges
      ctx.fillStyle = BRICKDARK;
      ctx.fillRect(b.x - cameraX,       b.y,           b.w, 2);
      ctx.fillRect(b.x - cameraX,       b.y+b.h-2,     b.w, 2);
      ctx.fillRect(b.x - cameraX,       b.y,           2,   b.h);
      // Mortar lines (half-brick pattern)
      ctx.fillStyle = 'rgba(0,0,0,0.25)';
      ctx.fillRect(b.x - cameraX+2,     b.y+b.h/2-1,   b.w-4, 2);
      ctx.fillRect(b.x - cameraX+b.w/2-1, b.y+2,       2,     b.h/2-2);
      ctx.fillRect(b.x - cameraX+2,     b.y+2,         b.w/2-4, b.h/2-3);
    }
  });

  // Question blocks
  qBlocks.forEach(q => {
    if (q.x - cameraX > W+16 || q.x+q.w - cameraX < -16) return;
    if (q.hit) {
      ctx.fillStyle = '#b87020';
      ctx.fillRect(q.x - cameraX, q.y, q.w, q.h);
    } else {
      ctx.fillStyle = BLOCK;
      ctx.fillRect(q.x - cameraX, q.y, q.w, q.h);
      ctx.fillStyle = BLOCKDARK;
      ctx.fillRect(q.x - cameraX,         q.y,       q.w, 2);
      ctx.fillRect(q.x - cameraX,         q.y+q.h-2, q.w, 2);
      ctx.fillRect(q.x - cameraX,         q.y,       2,   q.h);
      ctx.fillRect(q.x - cameraX+q.w-2,   q.y,       2,   q.h);
      // Flashing '?' symbol
      const flash = Math.floor(frame / 8) % 2;
      ctx.fillStyle = flash ? '#fff' : '#8b6010';
      ctx.font = 'bold 11px monospace';
      ctx.fillText('?', q.x - cameraX + 4, q.y + 12);
    }
  });
}

// ── DRAW PIPES ────────────────────────────────────────────
function drawPipes() {
  pipes.forEach(p => {
    if (p.x - cameraX > W+32 || p.x+p.w - cameraX < -32) return;

    // Pipe shaft
    ctx.fillStyle = PIPE;
    ctx.fillRect(p.x+2  - cameraX, p.y+14, p.w-4,  p.h-14);
    ctx.fillStyle = PIPEDARK;
    ctx.fillRect(p.x+2  - cameraX, p.y+14, 4,       p.h-14);  // left shadow
    ctx.fillStyle = 'rgba(255,255,255,0.12)';
    ctx.fillRect(p.x+7  - cameraX, p.y+14, 4,       p.h-14);  // highlight

    // Pipe cap (wider)
    ctx.fillStyle = PIPE;
    ctx.fillRect(p.x    - cameraX, p.y,    p.w,     14);
    ctx.fillStyle = PIPEDARK;
    ctx.fillRect(p.x    - cameraX, p.y,    4,       14);
    ctx.fillStyle = 'rgba(255,255,255,0.12)';
    ctx.fillRect(p.x+7  - cameraX, p.y,    4,       14);

    // Outlines
    ctx.strokeStyle = PIPEDARK; ctx.lineWidth = 1;
    ctx.strokeRect(p.x   - cameraX, p.y,    p.w,   14);
    ctx.strokeRect(p.x+2 - cameraX, p.y+14, p.w-4, p.h-14);
  });
}

// ── DRAW COINS ────────────────────────────────────────────
function drawCoins() {
  coins.forEach(c => {
    if (c.collected) return;
    if (c.x - cameraX > W+8 || c.x+c.w - cameraX < -8) return;
    const bob = Math.sin(frame * 0.1 + c.x * 0.05) * 2;
    ctx.fillStyle = COIN;
    ctx.beginPath();
    ctx.ellipse(c.x+4 - cameraX, c.y+6+bob, 5, 7, 0, 0, Math.PI*2);
    ctx.fill();
    ctx.fillStyle = '#ffa500';
    ctx.beginPath();
    ctx.ellipse(c.x+4 - cameraX, c.y+6+bob, 3, 5, 0, 0, Math.PI*2);
    ctx.fill();
    ctx.fillStyle = 'rgba(255,255,255,0.5)';
    ctx.fillRect(c.x+2 - cameraX, c.y+3+bob, 2, 4);
  });
}

// ── DRAW END FLAG ─────────────────────────────────────────
function drawFlag() {
  const fx = flagX - cameraX;
  // Pole
  ctx.fillStyle = '#aaa';
  ctx.fillRect(fx, flagY, 4, GY - flagY);
  // Golden ball on top
  ctx.fillStyle = '#ffd700';
  ctx.beginPath(); ctx.arc(fx+2, flagY, 5, 0, Math.PI*2); ctx.fill();
  // Flag drops down when player reaches it
  const fy = flagY + 8 + (flagReached ? Math.min(flagProgress * 2, 60) : 0);
  ctx.fillStyle = '#ff6b35';
  ctx.beginPath();
  ctx.moveTo(fx+4, fy); ctx.lineTo(fx+24, fy+8); ctx.lineTo(fx+4, fy+16);
  ctx.closePath(); ctx.fill();
  // Fish icon on flag
  ctx.font = '10px monospace';
  ctx.fillText('🐟', fx+6, fy+12);
}

// ── DRAW PLAYER (orange bird) ─────────────────────────────
function drawPlayer() {
  if (player.dead) return;
  let sx = player.x - cameraX;
  let sy = player.y;

  // Blink when invincible
  const alpha = player.invincible > 0 && Math.floor(player.invincible/4) % 2 === 0 ? 0.4 : 1;
  ctx.globalAlpha = alpha;
  ctx.save();

  // Flip horizontally when facing left
  if (player.dir < 0) {
    ctx.translate(sx + player.w, sy);
    ctx.scale(-1, 1);
    sx = 0; sy = 0;
  }

  const px = player.dir > 0 ? sx : 0;
  const py = sy;

  // Body (rounded orange rectangle)
  ctx.fillStyle = '#ff6b35';
  roundRect(ctx, px+2, py+8, 18, 18, 4);
  ctx.fillStyle = '#ff8c5a';
  roundRect(ctx, px+4, py+10, 14, 14, 3);

  // Wings (flap when in air)
  const wingOff = player.onGround ? 0 : Math.sin(frame * 0.3) * 3;
  ctx.fillStyle = '#ff6b35';
  ctx.beginPath(); ctx.ellipse(px-2,  py+12+wingOff, 7, 4, -0.3, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.ellipse(px+20, py+12-wingOff, 7, 4,  0.3, 0, Math.PI*2); ctx.fill();

  // Head
  ctx.fillStyle = '#ff8c5a';
  roundRect(ctx, px+4, py, 14, 12, 6);

  // Eye (white sclera + dark pupil + highlight)
  ctx.fillStyle = '#fff';
  roundRect(ctx, px+9, py+2, 6, 5, 2);
  ctx.fillStyle = '#1a1a2e';
  roundRect(ctx, px+11, py+3, 3, 3, 1);
  ctx.fillStyle = '#fff';
  ctx.fillRect(px+13, py+3, 1, 1);

  // Beak (triangle)
  ctx.fillStyle = '#ffd700';
  ctx.beginPath();
  ctx.moveTo(px+16, py+6); ctx.lineTo(px+21, py+8); ctx.lineTo(px+16, py+10);
  ctx.closePath(); ctx.fill();

  // Feet
  ctx.fillStyle = '#ffd700';
  ctx.fillRect(px+4,  py+24, 5, 3);
  ctx.fillRect(px+12, py+24, 5, 3);

  ctx.restore();
  ctx.globalAlpha = 1;
}

// ── DRAW PUFFERFISH ENEMY ─────────────────────────────────
function drawPuffer(e) {
  const sx = e.x - cameraX;
  if (e.dead) return;   // already removed after deathTimer expires

  ctx.save();
  // Flip to match direction
  if (e.dir > 0) { ctx.translate(sx + e.w, e.y); ctx.scale(-1, 1); }
  else            { ctx.translate(sx, e.y); }
  const x = 0, y = 0;
  const bob = Math.sin(e.animF * 0.1) * 2;

  // Round body
  ctx.fillStyle = '#4ec9e8';
  ctx.beginPath(); ctx.ellipse(x+9, y+9+bob, 9, 9, 0, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle = '#2aa0c0';
  ctx.beginPath(); ctx.ellipse(x+9, y+11+bob, 7, 6, 0, 0, Math.PI*2); ctx.fill();

  // Spikes radiating outward
  ctx.fillStyle = '#1a6fa8';
  for (let i = 0; i < 6; i++) {
    const a = (i / 6) * Math.PI * 2;
    ctx.beginPath();
    ctx.moveTo(x+9 + Math.cos(a)*9,  y+9+bob + Math.sin(a)*9);
    ctx.lineTo(x+9 + Math.cos(a)*14, y+9+bob + Math.sin(a)*14);
    ctx.lineTo(x+9 + Math.cos(a+.2)*10, y+9+bob + Math.sin(a+.2)*10);
    ctx.fill();
  }

  // Eye
  ctx.fillStyle = '#fff';
  ctx.beginPath(); ctx.arc(x+13, y+7+bob, 3, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle = '#000';
  ctx.beginPath(); ctx.arc(x+14, y+7+bob, 1.5, 0, Math.PI*2); ctx.fill();

  // Grumpy mouth
  ctx.strokeStyle = '#1a6fa8'; ctx.lineWidth = 1.5;
  ctx.beginPath(); ctx.arc(x+12, y+12+bob, 3, 0.2, Math.PI-0.2); ctx.stroke();

  ctx.restore();
}

// ── DRAW PELICAN ENEMY ────────────────────────────────────
function drawPelican(e) {
  if (e.dead) return;
  const sx = e.x - cameraX;

  ctx.save();
  if (e.dir < 0) { ctx.translate(sx + e.w, e.y); ctx.scale(-1, 1); }
  else            { ctx.translate(sx, e.y); }
  const x = 0, y = 0;
  const wingBeat = Math.sin(e.animF * 0.15) * 5;

  // Wings
  ctx.fillStyle = '#e8e8e8';
  ctx.beginPath(); ctx.ellipse(x+2,  y+10+wingBeat, 8, 4, -0.4, 0, Math.PI*2); ctx.fill();
  ctx.beginPath(); ctx.ellipse(x+20, y+10-wingBeat, 8, 4,  0.4, 0, Math.PI*2); ctx.fill();

  // Body
  ctx.fillStyle = '#f0f0f0';
  ctx.beginPath(); ctx.ellipse(x+11, y+13, 10, 7, 0, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle = '#d0d0d0';
  ctx.beginPath(); ctx.ellipse(x+11, y+15, 8, 5, 0, 0, Math.PI*2); ctx.fill();

  // Head
  ctx.fillStyle = '#f0f0f0';
  ctx.beginPath(); ctx.arc(x+15, y+6, 6, 0, Math.PI*2); ctx.fill();

  // Eye
  ctx.fillStyle = '#000';
  ctx.beginPath(); ctx.arc(x+17, y+4, 1.5, 0, Math.PI*2); ctx.fill();
  ctx.fillStyle = '#fff';
  ctx.fillRect(x+17, y+3, 1, 1);

  // Long beak with pouch
  ctx.fillStyle = '#e8a030';
  ctx.beginPath();
  ctx.moveTo(x+18, y+7); ctx.lineTo(x+28, y+9);
  ctx.lineTo(x+24, y+16); ctx.lineTo(x+18, y+12);
  ctx.closePath(); ctx.fill();
  ctx.strokeStyle = '#b87020'; ctx.lineWidth = 1; ctx.stroke();

  // Pouch bulge
  ctx.fillStyle = '#d4903a';
  ctx.beginPath(); ctx.ellipse(x+23, y+13, 4, 3, 0.2, 0, Math.PI*2); ctx.fill();

  ctx.restore();
}

// ── DRAW PARTICLES ────────────────────────────────────────
function drawParticles() {
  particles = particles.filter(p => {
    p.x  += p.vx;
    p.y  += p.vy;
    p.vy += 0.15;   // gravity
    p.life--;
    ctx.globalAlpha = p.life / p.maxLife;
    ctx.fillStyle   = p.col;
    ctx.fillRect(p.x - cameraX, p.y, p.w || 4, p.h || 4);
    ctx.globalAlpha = 1;
    return p.life > 0;
  });
}

function spawnParticles(x, y, col, count = 6) {
  for (let i = 0; i < count; i++) {
    particles.push({
      x, y,
      vx: (Math.random() - 0.5) * 3,
      vy: -Math.random() * 4 - 1,
      life: 20, maxLife: 20, col, w: 4, h: 4
    });
  }
}

// ── COLLISION DETECTION ───────────────────────────────────

// AABB overlap test
function rectOverlap(a, b) {
  return a.x < b.x+b.w && a.x+a.w > b.x &&
         a.y < b.y+b.h && a.y+a.h > b.y;
}

// Resolve player vs all solid tiles/objects
function collidePlayer() {
  player.onGround = false;

  const solids = [
    ...platforms,
    ...bricks.filter(b  => !b.hit),
    ...qBlocks.filter(q => !q.hit),
    ...pipes
  ];

  solids.forEach(p => {
    if (!rectOverlap(player, p)) return;

    const overlapX = Math.min(player.x+player.w, p.x+p.w) - Math.max(player.x, p.x);
    const overlapY = Math.min(player.y+player.h, p.y+p.h) - Math.max(player.y, p.y);

    if (overlapY <= overlapX) {
      // Vertical collision
      if (player.y + player.h/2 < p.y + p.h/2) {
        // Land on top
        player.y        = p.y - player.h;
        player.vy       = 0;
        player.onGround = true;
      } else {
        // Hit underside → bump block
        player.y  = p.y + p.h;
        player.vy = Math.abs(player.vy) * 0.3;
        const isDestructible = p.type !== 'ground' && p.type !== 'platform' && p.type !== 'stair';
        if (isDestructible) bumpBlock(p);
      }
    } else {
      // Horizontal collision → push out
      player.x  = player.x + player.w/2 < p.x + p.w/2 ? p.x - player.w : p.x + p.w;
      player.vx = 0;
    }
  });
}

// Hit a brick or question block from below
function bumpBlock(b) {
  if (b.hit) return;
  b.hit = true;
  spawnParticles(b.x + 8, b.y, b.coin ? COIN : BRICK, 8);
  if (b.coin) {
    score += 100;
    // Coin floats upward as a particle
    particles.push({
      x: b.x+4, y: b.y-8, vx: 0, vy: -2,
      life: 30, maxLife: 30, col: COIN, w: 8, h: 12
    });
  }
  updateHUD();
}

// ── ENEMY UPDATE ──────────────────────────────────────────
function updateEnemies() {
  enemies.forEach(e => {
    if (e.dead) { e.deathTimer--; return; }
    e.animF++;

    if (e.type === 'puffer') {
      e.x += e.vx;

      // Reverse direction when hitting pipes, platforms, or level edges
      [...pipes, ...platforms].forEach(p => {
        if (rectOverlap(e, p)) { e.vx *= -1; e.dir *= -1; e.x += e.vx * 2; }
      });
      if (e.x < 0) { e.vx = Math.abs(e.vx); e.dir = 1; }

      e.y = GY - e.h;   // lock to ground

    } else {
      // Pelican: patrol back and forth around startX
      e.x += e.vx * 0.8;
      if (e.x < e.startX - e.range) { e.vx =  1; e.dir =  1; }
      if (e.x > e.startX + e.range) { e.vx = -1; e.dir = -1; }
    }

    // Player collision check
    if (player.invincible > 0 || player.dead) return;
    if (!rectOverlap(player, { x:e.x, y:e.y, w:e.w, h:e.h })) return;

    const playerBottom = player.y + player.h;
    const enemyTop     = e.y;

    if (playerBottom - 4 <= enemyTop + 6 && player.vy > 0) {
      // Stomp! — kill enemy, bounce player up
      e.dead = true; e.deathTimer = 30;
      player.vy = -5;
      score += 200;
      spawnParticles(e.x + e.w/2, e.y, '#4ec9e8', 10);
      updateHUD();
    } else {
      // Player takes damage
      hurtPlayer();
    }
  });
}

// ── PLAYER HURT ───────────────────────────────────────────
function hurtPlayer() {
  if (player.invincible > 0 || player.dead) return;
  lives--;
  updateHUD();
  if (lives <= 0) {
    player.dead   = true;
    player.deathVy = -8;
    setTimeout(() => { gameState = 'dead'; showMessage('GAME OVER', 'Press START to try again'); }, 1500);
  } else {
    // Respawn with brief invincibility frames
    player.invincible = 120;
  }
}

// ── PLAYER UPDATE ─────────────────────────────────────────
function updatePlayer() {
  if (player.dead) {
    // Death animation: fly upward then fall
    player.y      += player.deathVy;
    player.deathVy += 0.4;
    return;
  }

  if (player.invincible > 0) player.invincible--;

  // Read inputs (keyboard + touch buttons)
  const left  = keys['ArrowLeft']  || keys['a'] || touchLeft;
  const right = keys['ArrowRight'] || keys['d'] || touchRight;
  const jump  = (keys['ArrowUp'] || keys['w'] || keys[' '] || touchUp) && player.onGround;

  // Horizontal movement
  if      (left)  { player.vx = -2.2; player.dir = -1; }
  else if (right) { player.vx =  2.2; player.dir =  1; }
  else            { player.vx *= 0.8; }   // friction

  // Jump
  if (jump) {
    player.vy = -7;
    player.onGround = false;
    spawnParticles(player.x + 11, player.y + player.h, '#7ee8a2', 3);
  }

  // Gravity
  player.vy = Math.min(player.vy + 0.35, 10);

  player.x += player.vx;
  player.y += player.vy;

  // Fell off-screen → lose a life
  if (player.y > H + 50) hurtPlayer();

  // Can't scroll left past camera
  if (player.x < cameraX) player.x = cameraX;

  collidePlayer();

  // Coin collection
  coins.forEach(c => {
    if (c.collected) return;
    if (rectOverlap(player, c)) {
      c.collected = true;
      score += 50;
      spawnParticles(c.x+4, c.y, COIN, 5);
      updateHUD();
    }
  });

  // Advance camera (never go backwards)
  const targetCam = player.x - 120;
  cameraX = Math.max(cameraX, Math.max(0, Math.min(targetCam, 175*TILE - W)));

  // Reach the flag → level clear
  if (!flagReached && player.x + player.w >= flagX && player.x <= flagX + 6) {
    flagReached = true;
    score += 1000;
    updateHUD();
    setTimeout(() => {
      gameState = 'win';
      showMessage('LEVEL CLEAR! 🐟🐦', 'Score: ' + score + '  —  Press START');
    }, 1500);
  }
}

// ── MAIN GAME LOOP ────────────────────────────────────────
let lastTime = 0;

function gameLoop(ts) {
  requestAnimationFrame(gameLoop);
  const dt = Math.min((ts - lastTime) / 16.67, 3);
  lastTime = ts;
  frame++;

  if (gameState !== 'playing') return;

  updatePlayer();
  updateEnemies();
  if (flagReached) flagProgress++;

  // Render in painter's order (back to front)
  drawBG();
  drawGround();
  drawPipes();
  drawFlag();
  drawBlocks();
  drawCoins();
  enemies.forEach(e => e.type === 'puffer' ? drawPuffer(e) : drawPelican(e));
  drawPlayer();
  drawParticles();
}

// ── HUD & MESSAGES ────────────────────────────────────────
function updateHUD() {
  document.getElementById('score').textContent = 'SCORE: ' + score;
  document.getElementById('lives').textContent = '❤️ x' + Math.max(0, lives);
  document.getElementById('level').textContent = 'WORLD ' + worldNum;
}

function showMessage(title, sub) {
  const m = document.getElementById('msg');
  m.innerHTML = '<h2>' + title + '</h2><p>' + sub + '</p>';
  m.style.display = 'block';
}
function hideMessage() { document.getElementById('msg').style.display = 'none'; }

// ── START / RESTART ───────────────────────────────────────
function startGame() {
  score = 0; lives = 3; worldNum = 1;
  buildLevel(1);

  player.x         = 80;
  player.y         = GY - player.h - 2;
  player.vx        = 0;
  player.vy        = 0;
  player.dir       = 1;
  player.onGround  = false;
  player.invincible = 0;
  player.dead       = false;
  flagReached       = false;

  updateHUD();
  gameState = 'playing';
  hideMessage();
}

// ── KEYBOARD INPUT ────────────────────────────────────────
document.addEventListener('keydown', e => { keys[e.code] = true;  keys[e.key] = true;  });
document.addEventListener('keyup',   e => { keys[e.code] = false; keys[e.key] = false; });

// ── TOUCH BUTTON INPUT ────────────────────────────────────
let touchLeft  = false;
let touchRight = false;
let touchUp    = false;

function bindBtn(id, onDown, onUp) {
  const el = document.getElementById(id);
  if (!el) return;
  el.addEventListener('touchstart', e => { e.preventDefault(); onDown(); }, { passive: false });
  el.addEventListener('touchend',   e => { e.preventDefault(); onUp();   }, { passive: false });
  el.addEventListener('mousedown',  onDown);
  el.addEventListener('mouseup',    onUp);
  el.addEventListener('mouseleave', onUp);
}

bindBtn('btnLeft',  () => touchLeft  = true, () => touchLeft  = false);
bindBtn('btnRight', () => touchRight = true, () => touchRight = false);
bindBtn('btnUp',    () => touchUp    = true, () => touchUp    = false);

// ── KICK OFF ──────────────────────────────────────────────
ctx.fillStyle = SKY;
ctx.fillRect(0, 0, W, H);

requestAnimationFrame(gameLoop);
</script>
